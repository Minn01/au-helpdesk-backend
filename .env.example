# Runtime
NODE_ENV=development
PORT=5050

# Secret source: environment for local development; production defaults to azure-key-vault.
# SECRET_SOURCE=azure-key-vault

# Local development secrets (do not commit real values)
DATABASE_URL=postgresql://user:password@localhost:5432/helpdesk
DIRECT_URL=postgresql://user:password@localhost:5432/helpdesk
JWT_SECRET=replace-with-at-least-32-random-characters
# MICROSOFT_CLIENT_SECRET=
# SUPABASE_SECRET_KEY=

# Non-secret integration configuration
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_REDIRECT_URI=http://localhost:5050/api/auth/microsoft/callback
# FRONTEND_URL=http://localhost:5173/helpdesk
# SUPABASE_URL=
# SUPABASE_STORAGE_BUCKET=ticket-attachments

# EduCore peer integration. Both API keys must be independently generated secrets.
# EDUCORE_BASE_URL=https://educore.example.edu
# HELPDESK_PEER_API_KEY=
# EDUCORE_API_KEY=
# EDUCORE_CONTEXT_PATH_TEMPLATE=/api/peer/helpdesk/registration-context/{eventId}
# EDUCORE_TIMEOUT_MS=4000

# Azure Key Vault bootstrap credentials. DefaultAzureCredential reads these
# when service-principal authentication is used for the development vault.
# AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
